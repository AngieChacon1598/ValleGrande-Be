	<parameter name="TICKET_ID" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    p.name AS nombre_producto,
    p.description AS descripcion_producto,
    pd.amount AS cantidad,
    p.price AS precio_unitario,
    (pd.amount * p.price) AS subtotal
FROM
    developer2.product_detail pd
JOIN
    developer2.product p ON pd.id = p.id
WHERE
    pd.ticket_id = $P{TICKET_ID}]]>
	</queryString>
