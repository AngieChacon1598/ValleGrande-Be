<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ListDate" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="719afb23-3864-47e0-8280-9452ff27932b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle Cloud"/>
	<parameter name="TICKET_ID_PRINCIPAL" class="java.math.BigDecimal"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    DISTINCT st.ticket_id AS id_ticket,
    st.sale_date AS fecha_ticket,
    ru.names || ' ' || ru.surnames AS cliente,
    ru.address AS direccion_cliente,
    st.total_payment AS total_pago,
    st.delivery,
    st.delivery_address,
    st.note,
    pt.name AS payment_method
FROM
    developer2.sales_ticket st
JOIN
    developer1.restaurant_user ru ON st.user_id = ru.user_id
JOIN
    developer2.payment_type pt ON st.id_payment_type = pt.id_payment_type
WHERE
    st.ticket_id = $P{TICKET_ID_PRINCIPAL}
ORDER BY
    st.sale_date ASC, st.ticket_id]]>
	</queryString>
