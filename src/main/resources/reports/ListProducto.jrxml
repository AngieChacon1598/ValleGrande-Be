	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle Cloud"/>
	<parameter name="ESTADO_PRODUCTO" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT  
    p."NAME",
    p."DESCRIPTION",
    p."PRICE",
    p."CREATED_AT",
    p."CATEGORY_ID",
    c."NAME" AS "CATEGORY_NAME",
    p."STATUS"
FROM 
    "PRODUCT" p
JOIN 
    "CATEGORY" c ON p."CATEGORY_ID" = c."ID"
WHERE 
    p."STATUS" = $P{ESTADO_PRODUCTO}]]>
	</queryString>
